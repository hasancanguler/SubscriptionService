  "components": {
    "schemas": {
      "CustomerModel": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "DiscountModel": {
        "type": "object",
        "properties": {
          "price": {
            "type": "number",
            "format": "double"
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "serviceId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "SubscribeRequest": {
        "type": "object",
        "properties": {
          "customer_phone_number": {
            "type": "integer",
            "format": "int64"
          },
          "service_id": {
            "type": "integer",
            "format": "int32"
          },
          "duration_months": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "SubscribeResponse": {
        "type": "object",
        "properties": {
          "subscribedServices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubscriptionModel"
            },
            "nullable": true
          },
          "subscriptionsCostBeforeDiscount": {
            "type": "number",
            "format": "double"
          },
          "subscriptionsCostAfterDiscount": {
            "type": "number",
            "format": "double"
          },
          "discounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiscountModel"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SubscriptionModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "custumer": {
            "$ref": "#/components/schemas/CustomerModel"
          },
          "serviceId": {
            "type": "integer",
            "format": "int32"
          },
          "servicePrice": {
            "type": "number",
            "format": "double"
          },
          "months": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "SubscriptionSummaryRequest": {
        "type": "object",
        "properties": {
          "customer_phone_number": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      }
    }
  }
